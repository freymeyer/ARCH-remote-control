NODE_ENV=production
PORT=3000
HOST=0.0.0.0
REMOTE_TOKEN=change-this-long-random-token
ALLOWED_IPS=192.168.1.0/24,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
ENABLE_HTTPS=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_EVENTS=120
MAX_MOUSE_DELTA=200
MAX_SCROLL_DELTA=100
